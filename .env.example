# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC...          # from @BotFather
OWNER_TG_USER_ID=123456789                # your Telegram user id (@userinfobot); everyone else is ignored
WEBHOOK_BASE_URL=https://olxbot.example.com   # VPS: your subdomain (nginx); local: the ngrok https URL
WEBHOOK_SECRET=change-me-random-string    # openssl rand -hex 32
CLAUDE_CODE_OAUTH_TOKEN=...               # `claude setup-token`

# --- Docker Compose (read by compose itself) ---
BOT_PORT=8000                             # host port (127.0.0.1 only) nginx/ngrok forwards to; pick a free one
# OLX_MCP_SOURCE=../olx-mcp               # build olx-mcp from a local checkout instead of the pinned GitHub commit
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml   # local dev: also publish olx-mcp on 127.0.0.1:3000

# --- only when running the bot on the host (uv run olx-hunter-bot) ---
# OLX_MCP_URL=http://127.0.0.1:3000/mcp   # needs docker-compose.dev.yml (publishes olx-mcp)

# --- optional (defaults shown) ---
# AGENT_MODEL=                            # empty → Claude Code default
# HUNT_INTERVAL_MINUTES=180               # for hunts with automatic checks on (/auto N on)
# QUIET_HOURS_START=1                     # no automatic runs 01:00-07:00 local time
# QUIET_HOURS_END=7
# TIMEZONE=Europe/Kyiv
# MIN_DEAL_SCORE=6                        # 0-10; lower-scored listings aren't sent
# MAX_CONCURRENT_HUNTS=2
# HUNT_MAX_TURNS=40
# CHAT_MAX_TURNS=30
# SCHEDULER_TICK_SECONDS=60
# LOG_LEVEL=INFO
# Host-run only (compose sets these for the container):
# OLX_MCP_PATH=../olx-mcp/dist/index.js  # only used when OLX_MCP_URL is unset (local stdio build)
# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=8000
